# ========================================================
# إعدادات المزامنة التلقائية مع مودل الجامعة الإسلامية (IUG)
# ========================================================
# تنبيه هام: هذا الملف شخصي وسري للغاية ولا يُرفع إطلاقاً لمستودع GitHub
# بعد إدخال بياناتك، تأكد من حفظ الملف باسم: .env

# رقم الطالب الجامعي (اسم المستخدم)
MOODLE_USERNAME=

# كلمة المرور الخاصة بحسابك على المودل
MOODLE_PASSWORD=

# هل ترغب برفع التحديثات تلقائياً إلى الاستضافة (GitHub Pages) عند وجود ملفات جديدة؟
# true = نعم، ارفع فوراً
# false = قم بالتنزيل والتحديث محلياً فقط دون رفع
AUTO_GIT_PUSH=true
